# Скопируйте этот файл в .env и заполните значения.
# ВАЖНО: токен бота — секрет. Не публикуйте .env в GitHub!

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=ЗДЕСЬ_ТОКЕН_ОТ_BOTFATHER

# Общая Google-таблица по умолчанию. Каждый пользователь может задать свою
# командой /sheet в Telegram — она сохранится в его личном аккаунте.
# Таблица должна быть доступна «Все, у кого есть ссылка — просмотрщик».
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1eVAliG0JG98RCFXPeAhbSsDNn_CWL7LQKIDr0ZLBdZo/edit?gid=0#gid=0

# Интервал опроса таблицы, сек
POLL_INTERVAL=60

# Имя колонки со ШК
BARCODE_COLUMN=ШК

# Колонка со статусом (уведомления только если она пустая)
STATUS_COLUMN=Статус

# Колонка с ID сотрудника в таблице
EMPLOYEE_ID_COLUMN=ID

# Стартовый список ID сотрудников для новых аккаунтов (через запятую).
# Пусто = следить за всеми. Каждый пользователь меняет свой список сам.
TARGET_EMPLOYEE_IDS=5978877

# ID по умолчанию для кнопки «🔎 Поиск по ID»
DEFAULT_LOOKUP_EMPLOYEE_ID=5978877

# Telegram ID администраторов (через запятую). Пусто = доступ открыт всем.
# Админы могут пользоваться /access и /users. Свой ID: /id.
ALLOWED_USER_IDS=
