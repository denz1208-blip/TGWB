# Скопируйте этот файл в .env и заполните значения

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=8545402880:AAGg_mvy-rbQKj0H5eVAFiTbNS2-8U7pEA0

# Ссылка на Google Таблицу (таблица должна быть доступна "по ссылке")
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1eVAliG0JG98RCFXPeAhbSsDNn_CWL7LQKIDr0ZLBdZo/edit?gid=0#gid=0

# Интервал опроса таблицы, сек
POLL_INTERVAL=60

# Имя колонки со штрихкодами
BARCODE_COLUMN=ШК

# Колонка со статусом (уведомления только если она пустая)
STATUS_COLUMN=Статус

# Колонка с ID сотрудника в таблице
EMPLOYEE_ID_COLUMN=ID

# ID сотрудников, за которыми следим (через запятую). Пусто = за всеми.
# Пример: TARGET_EMPLOYEE_IDS=112946,5994498
TARGET_EMPLOYEE_IDS=5978877

# Белый список Telegram ID пользователей, которым разрешён доступ к боту.
# Пусто = доступ открыт всем. Свой ID можно узнать командой /id.
# Управление без перезапуска: /access add <ID>, /access remove <ID>, /access clear
ALLOWED_USER_IDS=
