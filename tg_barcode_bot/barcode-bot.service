[Unit]
Description=Telegram bot: new barcode watcher (Google Sheets)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Замените на вашего пользователя и путь к проекту
User=ubuntu
WorkingDirectory=/opt/tg_barcode_bot
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/tg_barcode_bot/venv/bin/python /opt/tg_barcode_bot/bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
